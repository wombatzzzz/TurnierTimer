<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Einstellungen"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Startzeit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Startzeit des ersten Spiels:" />

        <Button
            android:id="@+id/btnStartzeit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Uhrzeit wählen" />

        <!-- Zeitslot -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Länge eines Zeitslots (Spiel + Pause) in Minuten:" />

        <EditText
            android:id="@+id/etZeitslot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="z.B. 15"
            android:inputType="number"
            android:text="30" />

        <!-- Letzte-x-Minuten -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Letzte-x-Minuten-Jingle spielen nach wie vielen Minuten?" />

        <EditText
            android:id="@+id/etLetzteMinMinuten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="z.B. 25"
            android:inputType="number"
            android:text="25" />

        <!-- Schluss -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Schluss-Jingle spielen nach wie vielen Minuten?" />

        <EditText
            android:id="@+id/etSchlussMinuten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="z.B. 27"
            android:inputType="number"
            android:text="27" />

        <!-- Trennlinie -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <!-- Jingle Auswahl -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start-Jingle (vom Handy):" />

        <Button
            android:id="@+id/btnStartJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 Start-Jingle auswählen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Letzte-x-Minuten-Jingle (vom Handy):" />

        <Button
            android:id="@+id/btnLetzteMinJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 Letzte-x-Minuten-Jingle auswählen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Schluss-Jingle (vom Handy):" />

        <Button
            android:id="@+id/btnSchlussJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 Schluss-Jingle auswählen" />

        <!-- Trennlinie -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <!-- Test Buttons -->
        <Button
            android:id="@+id/btnTestStartJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2196F3"
            android:text="▶ Start-Jingle testen"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTestLetzteMinJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2196F3"
            android:text="▶ Letzte-x-Minuten-Jingle testen"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTestSchlussJingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2196F3"
            android:text="▶ Schluss-Jingle testen"
            android:textColor="#FFFFFF" />

        <!-- Speichern -->
        <Button
            android:id="@+id/btnSpeichern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#FF9800"
            android:text="💾 Einstellungen speichern"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
